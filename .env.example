# 회원가입은 두 값이 모두 일치할 때만 서버에서 활성화됩니다.
SIGNUP_ENABLED=false
LEGAL_DOCUMENT_STATUS=draft
ACCOUNT_HASH_SECRET=

# 가입 축하/관리자 가입 알림/계정 찾기/비밀번호 재설정 이메일 발송(Resend)
RESEND_API_KEY=
RESEND_FROM=메디헬퍼스 <no-reply@medihelpers.co.kr>
ALERT_EMAIL_TO=

# QA 기간에는 true. 정식 출시 전 false로 바꾸면 헤더/로그인 테스트 계정 전환과 API가 함께 비활성화됩니다.
TEST_ACCOUNT_SWITCH_ENABLED=true
# Migration controls: open | drain (existing approval only) | frozen (all APIs).
# In-flight requests must be settled before final backup. No secrets here.
MIGRATION_MODE=open
CHECKOUT_ENABLED=true

# Server-only Inicis credentials: use deployment secret storage, never browser variables.
# test/live selects real PG staging/production endpoints; neither is virtual payment.
INICIS_ENV=test
INICIS_MID=
INICIS_SIGN_KEY=
INICIS_API_KEY=
# INIAPI requires approved merchant/IP configuration. Never guess an egress IP.
INICIS_CLIENT_IP=
INICIS_REFUNDS_ENABLED=false
SITE_ORIGIN=
# Keep true on Cloudflare even during staging: missing PG keys must never grant free rights.
PAYMENT_LIVE=true
