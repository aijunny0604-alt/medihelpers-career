{
  "name": "medihelpers-renewal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --outDir client-build && node scripts/package-sites.mjs",
    "preview": "vite preview --outDir client-build",
    "build:pages": "vite build --outDir client-build",
    "test": "node --test src/*.test.js",
    "test:runtime": "npm run build && node scripts/runtime-readiness-audit.mjs",
    "test:adversarial": "npm run build && node scripts/runtime-adversarial-audit.mjs",
    "build:cf": "vite build --outDir client-build && node scripts/package-sites.mjs --target=cloudflare"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vinext": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
